<?xml version="1.0"?>
<robot name="agricultural_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Robot dimensions ===== -->
  <xacro:property name="base_length"     value="0.60"/>
  <xacro:property name="base_width"      value="0.40"/>
  <xacro:property name="base_height"     value="0.20"/>
  <xacro:property name="wheel_radius"    value="0.15"/>
  <xacro:property name="wheel_width"     value="0.06"/>
  <!-- wheel separation = body width + one wheel width (wheels flush with body sides) -->
  <xacro:property name="wheel_sep"       value="0.46"/>
  <xacro:property name="caster_radius"   value="0.05"/>
  <xacro:property name="robot_mass"      value="25.0"/>
  <xacro:property name="wheel_mass"      value="2.0"/>

  <!-- ===== Materials ===== -->
  <material name="orange"><color rgba="0.88 0.47 0.10 1.0"/></material>
  <material name="black"> <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="grey">  <color rgba="0.55 0.55 0.55 1.0"/></material>
  <material name="blue">  <color rgba="0.20 0.40 0.80 1.0"/></material>
  <material name="white"> <color rgba="0.90 0.90 0.90 1.0"/></material>

  <!-- ===================================================
       BASE_FOOTPRINT  (ground-level root frame)
       =================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================
       BASE_LINK  (robot body)
       =================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_height/2}"/>
      <mass value="${robot_mass}"/>
      <inertia
        ixx="${robot_mass*(base_width**2  + base_height**2)/12}"
        iyy="${robot_mass*(base_length**2 + base_height**2)/12}"
        izz="${robot_mass*(base_length**2 + base_width**2) /12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===================================================
       DRIVE WHEELS (continuous joints)
       rpy="-pi/2 0 0" rotates cylinder z-axis → parent y-axis
       axis="0 0 1" then spins around that (parent-y = world-y)
       =================================================== -->
  <xacro:macro name="wheel" params="name y_sign">
    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass*(3*wheel_radius**2 + wheel_width**2)/12}"
          iyy="${wheel_mass*(3*wheel_radius**2 + wheel_width**2)/12}"
          izz="${wheel_mass*wheel_radius**2/2}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="0 ${y_sign * wheel_sep/2} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left"  y_sign=" 1"/>
  <xacro:wheel name="right" y_sign="-1"/>

  <!-- ===================================================
       REAR CASTER (passive, frictionless)
       =================================================== -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel"/>
    <!-- rear of body, dropped so the sphere rests on the ground -->
    <origin xyz="${-(base_length/2 - caster_radius)} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ===================================================
       2-D LIDAR  (mounted on top of body)
       =================================================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${base_height + 0.035}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================
       FRONT CAMERA
       =================================================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.08 0.05"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.08 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length/2 - 0.025} 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================
       GAZEBO – body colour
       =================================================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="camera_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ===================================================
       GAZEBO PLUGIN – Differential Drive (Harmonic)
       Subscribes to Gz topic "cmd_vel"; publishes "odom" and "tf".
       The ros_gz_bridge in simulation.launch.py bridges these to ROS.
       =================================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <!-- Gz topic names — bridged to ROS by ros_gz_bridge -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
    </plugin>
  </gazebo>

  <!-- ===================================================
       GAZEBO PLUGIN – Joint State Publisher (Harmonic)
       Publishes wheel joint positions/velocities so
       robot_state_publisher can compute wheel link TFs.
       Bridged to ROS by ros_gz_bridge in simulation.launch.py.
       =================================================== -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ===================================================
       GAZEBO SENSOR – 2-D LIDAR  (gpu_lidar type)
       =================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================================================
       GAZEBO SENSOR – Front Camera
       =================================================== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <gz_frame_id>camera_link</gz_frame_id>
      <topic>camera/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================================================
       GAZEBO SENSOR – IMU
       =================================================== -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>base_link</gz_frame_id>
      <topic>imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
