<?xml version="1.0" ?>
<sdf version="1.9">
<world name="farm_world">

  <!-- ── Plugins ─────────────────────────────────────────────────────────── -->
  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-contact-system"
          name="gz::sim::systems::Contact"/>
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-imu-system"
          name="gz::sim::systems::Imu"/>

  <!-- ── Physics ─────────────────────────────────────────────────────────── -->
  <physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>1000</real_time_update_rate>
  </physics>

  <!-- ── Scene ───────────────────────────────────────────────────────────── -->
  <scene>
    <ambient>0.4 0.4 0.4 1</ambient>
    <background>0.53 0.81 0.98 1</background>
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <!-- ── GUI: fixed default camera — top-down, north-up ────────────────────
       Field is 22 m (x, east-west) × 24 m (y, north-south), centred on
       (0,0). Camera sits directly above the field centre looking straight
       down (pitch = π/2 about the world Y axis) then yawed π/2 about the
       world Z axis so the image's "up" is world +Y (north) and the
       image's "right" is world +X (east) — i.e. north-up on screen,
       matching a standard map view. Height (z=32) gives margin beyond the
       24 m long axis so the whole field is visible without clipping.
       Plugin set below mirrors gz-sim8's own default GUI (MinimalScene +
       standard companion plugins) so nothing else about the GUI changes
       except the startup camera pose. ─────────────────────────────────── -->
  <gui fullscreen="0">
    <plugin filename="MinimalScene" name="3D View">
      <gz-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </gz-gui>
      <engine>ogre2</engine>
      <scene>scene</scene>
      <ambient_light>0.4 0.4 0.4</ambient_light>
      <background_color>0.53 0.81 0.98</background_color>
      <camera_pose>0 0 32 0 1.570796 1.570796</camera_pose>
      <camera_clip>
        <near>0.25</near>
        <far>25000</far>
      </camera_clip>
    </plugin>

    <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
      <gz-gui>
        <property key="state" type="string">floating</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="GzSceneManager" name="Scene Manager">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="InteractiveViewControl" name="Interactive view control">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>
    <plugin filename="CameraTracking" name="Camera Tracking">
      <gz-gui>
        <property key="resizable" type="bool">false</property>
        <property key="width" type="double">5</property>
        <property key="height" type="double">5</property>
        <property key="state" type="string">floating</property>
        <property key="showTitleBar" type="bool">false</property>
      </gz-gui>
    </plugin>

    <plugin filename="WorldControl" name="World control">
      <gz-gui>
        <title>World control</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">72</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </gz-gui>
      <play_pause>true</play_pause>
      <step>true</step>
      <start_paused>true</start_paused>
      <use_event>true</use_event>
    </plugin>

    <plugin filename="WorldStats" name="World stats">
      <gz-gui>
        <title>World stats</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">110</property>
        <property type="double" key="width">290</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </gz-gui>
      <sim_time>true</sim_time>
      <real_time>true</real_time>
      <real_time_factor>true</real_time_factor>
      <iterations>true</iterations>
    </plugin>

    <plugin filename="ComponentInspector" name="Component inspector">
      <gz-gui>
        <property type="string" key="state">docked</property>
      </gz-gui>
    </plugin>

    <plugin filename="EntityTree" name="Entity tree">
      <gz-gui>
        <property type="string" key="state">docked</property>
      </gz-gui>
    </plugin>
  </gui>

  <!-- ── Sun ─────────────────────────────────────────────────────────────── -->
  <light type="directional" name="sun">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 100 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
  </light>

  <!-- ── Ground: grass 40×40 m — collision + green visual ─────────────────── -->
  <model name="ground_grass">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>40 40</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <plane><normal>0 0 1</normal><size>40 40</size></plane>
        </geometry>
        <material>
          <ambient>0.22 0.42 0.10 1</ambient>
          <diffuse>0.28 0.52 0.13 1</diffuse>
          <specular>0.02 0.04 0.01 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ── Ground: soil patch 20×22 m — visual only, sits just above grass ──── -->
  <model name="ground_soil">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <pose>0 0 0.0005 0 0 0</pose>
        <geometry>
          <box><size>20 22 0.001</size></box>
        </geometry>
        <material>
          <ambient>0.42 0.31 0.18 1</ambient>
          <diffuse>0.52 0.40 0.24 1</diffuse>
          <specular>0.05 0.04 0.02 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ── Boundary walls — x=±11, y=±12, 0.5 m tall ────────────────────────── -->
  <model name="wall_north">
    <static>true</static>
    <pose>0 12 0.25 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>22.6 0.3 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>22.6 0.3 0.5</size></box></geometry>
        <material><ambient>0.55 0.40 0.22 1</ambient><diffuse>0.65 0.50 0.28 1</diffuse></material>
      </visual>
    </link>
  </model>
  <model name="wall_south">
    <static>true</static>
    <pose>0 -12 0.25 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>22.6 0.3 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>22.6 0.3 0.5</size></box></geometry>
        <material><ambient>0.55 0.40 0.22 1</ambient><diffuse>0.65 0.50 0.28 1</diffuse></material>
      </visual>
    </link>
  </model>
  <model name="wall_east">
    <static>true</static>
    <pose>11 0 0.25 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>0.3 24 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 24 0.5</size></box></geometry>
        <material><ambient>0.55 0.40 0.22 1</ambient><diffuse>0.65 0.50 0.28 1</diffuse></material>
      </visual>
    </link>
  </model>
  <model name="wall_west">
    <static>true</static>
    <pose>-11 0 0.25 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>0.3 24 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 24 0.5</size></box></geometry>
        <material><ambient>0.55 0.40 0.22 1</ambient><diffuse>0.65 0.50 0.28 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ── Obstacles ─────────────────────────────────────────────────────────── -->
  <!-- obstacle_rock: west aisle between row x=-8 and row x=-4, midpoint x=-6 -->
  <model name="obstacle_rock">
    <static>true</static>
    <pose>-6 -4 0 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>0.5 0.4 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.4 0.3</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
      </visual>
    </link>
  </model>
  <!-- obstacle_crate: east aisle between row x=4 and row x=8, midpoint x=6 -->
  <model name="obstacle_crate">
    <static>true</static>
    <pose>6 3 0 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
        <material><ambient>0.60 0.45 0.20 1</ambient><diffuse>0.70 0.55 0.25 1</diffuse></material>
      </visual>
    </link>
  </model>
  <!-- obstacle_post: centre row x=0, between plants at y=-7 and y=-5 -->
  <model name="obstacle_post">
    <static>true</static>
    <pose>0 -6 0.4 0 0 0</pose>
    <link name="link">
      <collision name="c"><geometry><box><size>0.2 0.2 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 0.2 0.8</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ── 50 maize plants: 5 rows × 10 plants, y = -9 to 9 at 2 m spacing ──── -->
  <!-- Row 0  x=-8 -->
  <include><uri>model://maize_01</uri><name>maize_r0_p0</name><pose>-8 -9 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r0_p1</name><pose>-8 -7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r0_p2</name><pose>-8 -5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r0_p3</name><pose>-8 -3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r0_p4</name><pose>-8 -1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r0_p5</name><pose>-8  1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r0_p6</name><pose>-8  3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r0_p7</name><pose>-8  5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r0_p8</name><pose>-8  7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r0_p9</name><pose>-8  9 0 0 0 0</pose><static>true</static></include>

  <!-- Row 1  x=-4 -->
  <include><uri>model://maize_02</uri><name>maize_r1_p0</name><pose>-4 -9 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r1_p1</name><pose>-4 -7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r1_p2</name><pose>-4 -5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r1_p3</name><pose>-4 -3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r1_p4</name><pose>-4 -1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r1_p5</name><pose>-4  1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r1_p6</name><pose>-4  3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r1_p7</name><pose>-4  5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r1_p8</name><pose>-4  7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r1_p9</name><pose>-4  9 0 0 0 0</pose><static>true</static></include>

  <!-- Row 2  x=0 -->
  <include><uri>model://maize_01</uri><name>maize_r2_p0</name><pose>0 -9 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r2_p1</name><pose>0 -7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r2_p2</name><pose>0 -5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r2_p3</name><pose>0 -3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r2_p4</name><pose>0 -1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r2_p5</name><pose>0  1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r2_p6</name><pose>0  3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r2_p7</name><pose>0  5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r2_p8</name><pose>0  7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r2_p9</name><pose>0  9 0 0 0 0</pose><static>true</static></include>

  <!-- Row 3  x=4 -->
  <include><uri>model://maize_02</uri><name>maize_r3_p0</name><pose>4 -9 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r3_p1</name><pose>4 -7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r3_p2</name><pose>4 -5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r3_p3</name><pose>4 -3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r3_p4</name><pose>4 -1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r3_p5</name><pose>4  1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r3_p6</name><pose>4  3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r3_p7</name><pose>4  5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r3_p8</name><pose>4  7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r3_p9</name><pose>4  9 0 0 0 0</pose><static>true</static></include>

  <!-- Row 4  x=8 -->
  <include><uri>model://maize_01</uri><name>maize_r4_p0</name><pose>8 -9 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r4_p1</name><pose>8 -7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r4_p2</name><pose>8 -5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r4_p3</name><pose>8 -3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r4_p4</name><pose>8 -1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r4_p5</name><pose>8  1 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r4_p6</name><pose>8  3 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r4_p7</name><pose>8  5 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_01</uri><name>maize_r4_p8</name><pose>8  7 0 0 0 0</pose><static>true</static></include>
  <include><uri>model://maize_02</uri><name>maize_r4_p9</name><pose>8  9 0 0 0 0</pose><static>true</static></include>

  <!-- ── TurtleBot3 Waffle ──────────────────────────────────────────────────── -->
  <include>
    <uri>model://turtlebot3_waffle</uri>
    <name>turtlebot3_waffle</name>
    <pose>-9.5 -10 0.2 0 0 1.5708</pose>
  </include>

</world>
</sdf>
